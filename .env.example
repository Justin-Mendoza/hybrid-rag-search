# Copy this file to .env and replace placeholders locally. Never commit .env.
COHERE_API_KEY=replace-with-your-cohere-api-key
# Existing local setups may use COHERE_TRIAL_KEY instead; COHERE_API_KEY takes precedence.
COHERE_EMBED_MODEL=embed-english-light-v3.0
COHERE_EMBED_DIMENSIONS=384
COHERE_TIMEOUT_SECONDS=10
# Set only after verifying the selected model's USD price per million input tokens.
# Omitted means estimated cost is unknown (not zero).
# COHERE_EMBED_USD_PER_MILLION_TOKENS=...
COHERE_RERANK_MODEL=rerank-v4.0-fast
COHERE_RERANK_TIMEOUT_SECONDS=2
# Set only after verifying the selected model's USD price per search unit.
# COHERE_RERANK_USD_PER_SEARCH_UNIT=...
COHERE_GENERATION_MODEL=command-r7b-12-2024
COHERE_GENERATION_TIMEOUT_SECONDS=30
COHERE_GENERATION_TEMPERATURE=0
# Verified for command-r7b-12-2024 on 2026-09-17; recheck when changing models.
COHERE_GENERATION_INPUT_USD_PER_MILLION_TOKENS=0.0375
COHERE_GENERATION_OUTPUT_USD_PER_MILLION_TOKENS=0.15
# Test command sets this explicitly. A key alone never enables live tests.
# RUN_LIVE_COHERE_TESTS=1
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql://hybrid_rag:local-development-only@localhost:5432/hybrid_rag
REDIS_URL=redis://localhost:6379/0
OPENSEARCH_URL=http://localhost:9200
STORAGE_ROOT=.data/originals
TOKENIZER_ROOT=.data/tokenizers
INGESTION_ARTIFACT_ROOT=.data/ingestion-artifacts

# Local Docker Compose defaults. These values are for local development only.
POSTGRES_DB=hybrid_rag
POSTGRES_USER=hybrid_rag
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=3000
REDIS_PORT=6379
OPENSEARCH_PORT=9200
OPENSEARCH_METRICS_PORT=9600
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
