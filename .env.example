# Copy this file to .env and replace placeholders locally. Never commit .env.
COHERE_API_KEY=replace-with-your-cohere-api-key
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql://hybrid_rag:local-development-only@localhost:5432/hybrid_rag
REDIS_URL=redis://localhost:6379/0
OPENSEARCH_URL=http://localhost:9200
STORAGE_ROOT=.data/originals

# Local Docker Compose defaults. These values are for local development only.
POSTGRES_DB=hybrid_rag
POSTGRES_USER=hybrid_rag
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=3000
REDIS_PORT=6379
OPENSEARCH_PORT=9200
OPENSEARCH_METRICS_PORT=9600
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
